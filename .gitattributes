# Canonical repository format: every detected text file is UTF-8/LF on every
# host. Binary formats must be declared explicitly below before renormalizing.
* text=auto eol=lf

# Binary assets are never passed through text or diff conversion.
*.png binary

# Golden diagnostic fixtures must remain text with LF line endings.
*.aru text eol=lf
*.diag text eol=lf
*.hir text eol=lf
*.amir text eol=lf
*.ast text eol=lf
*.tokens text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.seed text eol=lf
*.toml text eol=lf
editors/vscode/package.json text eol=lf
editors/vscode/package-lock.json text eol=lf
tests/fuzz-regressions/manifest.tsv text eol=lf
