module examples.minimal.m10_path_empty

// Minimal 0.1 — std.path (isEmpty / isAbsolute / join / fileName).
import std.path as path

func main(): int {
    // isEmpty
    if !path.isEmpty("") {
        return 1
    }
    if path.isEmpty("x") {
        return 2
    }

    // isAbsolute
    if !path.isAbsolute("/tmp") {
        return 3
    }
    if !path.isAbsolute("/") {
        return 4
    }
    if path.isAbsolute("rel") {
        return 5
    }
    if path.isAbsolute("./x") {
        return 6
    }
    if path.isAbsolute("") {
        return 7
    }

    // join
    if path.join("a", "b") != "a/b" {
        return 8
    }
    if path.join("/tmp", "x") != "/tmp/x" {
        return 9
    }
    if path.join("/tmp", "/abs") != "/abs" {
        return 10
    }

    // fileName
    if path.fileName("leaf") != "leaf" {
        return 11
    }
    if path.fileName("/tmp/leaf") != "leaf" {
        return 12
    }
    if path.fileName("/tmp/x/y") != "y" {
        return 13
    }

    return 0
}
