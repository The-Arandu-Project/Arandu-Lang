module examples.minimal.m10_path_empty_windows

// Windows variant of m10_path_empty. `std.path` follows host semantics.
import std.path as path

func main(): int {
    if !path.isEmpty("") {
        return 1
    }
    if path.isEmpty("x") {
        return 2
    }

    if !path.isAbsolute("C:\\") {
        return 3
    }
    if path.isAbsolute("rel") {
        return 4
    }
    if path.isAbsolute(".\\x") {
        return 5
    }

    if path.fileName(path.join("a", "b")) != "b" {
        return 6
    }
    if path.fileName(path.join("C:\\tmp", "x")) != "x" {
        return 7
    }
    if path.fileName(path.join("C:\\tmp", "C:\\abs")) != "abs" {
        return 8
    }

    if path.fileName("C:\\tmp\\leaf") != "leaf" {
        return 9
    }
    return 0
}
