// std.core.intrinsics — zero-heap compiler-mapped traps and builtins.
//
// Layer rule: this module must never allocate on the heap. Fatal failures use
// native hardware traps (UD2 on x86, BRK on ARM, abort on C/Wasm).

module std.core.intrinsics

extern "arandu-intrinsic" {
    /// Unconditional fatal trap (out-of-bounds, failed assertions, etc.).
    func abort() : void

    /// Generational ref mismatch trap: slot was recycled (use-after-free detected).
    /// Used by `std.alloc.gen_arena` verification paths and compiler-lowered `GenGet` nodes.
    func abortGenerationalMismatch() : void
    func sliceFromRaw<Owner, T>(owner: ref Owner, data: ptr[T], len: uint): []T
    func sliceLen<T>(source: []T): uint
    func sliceSubslice<T>(source: []T, start: uint, len: uint): []T
    func strView<Owner>(owner: ref Owner): ref str
}
