module std.core.slice

import std.core.intrinsics as intrinsics

/// Number of elements in the built-in borrowed view `[]T`.
public func len<T>(s: []T): u64 {
    unsafe {
        return intrinsics.sliceLen<T>(s)
    }
}

public func isEmpty<T>(s: []T): bool {
    return len<T>(s) == 0 as u64
}

/// Element borrow at `index`, or `None` when out of bounds.
public func get<T>(s: []T, index: u64): Option<ref T> {
    if index >= len<T>(s) {
        return Option.None
    }
    return Option.Some(ref s[index])
}

public func first<T>(s: []T): Option<ref T> {
    return get<T>(s, 0 as u64)
}

public func last<T>(s: []T): Option<ref T> {
    let count = len<T>(s)
    if count == 0 as u64 {
        return Option.None
    }
    return get<T>(s, count - 1 as u64)
}

/// Checked half-open subview.
public func subslice<T>(s: []T, start: u64, count: u64): Option<[]T> {
    let total = len<T>(s)
    if start > total || count > total - start {
        return Option.None
    }
    unsafe {
        return Option.Some(intrinsics.sliceSubslice<T>(s, start, count))
    }
}

/// Minimal allocation-free iterator over shared element borrows.
public struct Iterator<T> {
    view: []T
    index: u64
}

public func iter<T>(s: []T): Iterator<T> {
    return Iterator<T> { view: s, index: 0 as u64 }
}

public func Iterator.next<T>(mut self): Option<ref T> {
    let item = get<T>(self.view, self.index)
    if self.index < len<T>(self.view) {
        self.index = self.index + 1 as u64
    }
    return item
}
