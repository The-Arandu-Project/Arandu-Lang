module std.path

/// Minimal 0.1 — path helpers.
///
/// | Function      | Status |
/// |---------------|--------|
/// | `isEmpty`     | pure |
/// | `isAbsolute`  | host `std::path::Path::is_absolute` |
/// | `join`        | host `Path::join` (OS separator / absolute replace) |
/// | `fileName`    | host `Path::file_name` (empty when none) |

extern "C" {
    func ar_path_is_absolute(p: str): int
    func ar_path_join(a: str, b: str): str
    func ar_path_file_name(p: str): str
}

/// True when the path has zero length.
public func isEmpty(p: str): bool {
    return p == ""
}

/// True when `p` is absolute on the host OS. Empty is never absolute.
public func isAbsolute(p: str): bool {
    if p == "" {
        return false
    }
    unsafe {
        return ar_path_is_absolute(p) != 0
    }
}

/// Join two path segments.
public func join(a: str, b: str): str {
    unsafe {
        return ar_path_join(a, b)
    }
}

/// Final path component, or empty string when none.
public func fileName(p: str): str {
    unsafe {
        return ar_path_file_name(p)
    }
}
