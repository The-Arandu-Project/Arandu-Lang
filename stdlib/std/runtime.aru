    unsafe {
        return Supervisor { id: ar_rt_supervisor_create() }
    }
}

public func destroySupervisor(s: ref Supervisor): void {
    unsafe {
        ar_rt_supervisor_destroy(s.id)
    }
}

/// Spawn `path` as a worker. `maxRestarts` allows automatic restart on exit.
/// Path is a fat `str` (ptr+len ABI).
public func supervisorSpawn(s: ref Supervisor, path: str, maxRestarts: int): WorkerHandle {
    unsafe {
        return WorkerHandle { id: ar_rt_supervisor_spawn_str(s.id, path, maxRestarts) }
    }
}

// Host wrapper that accepts language `str` (fat) — declared with str ABI.
extern "C" {
    func ar_rt_supervisor_spawn_str(sup: int, path: str, max_restarts: int): int
}

public func supervisorPoll(s: ref Supervisor, w: WorkerHandle): int {
    unsafe {
        return ar_rt_supervisor_poll(s.id, w.id)
    }
}

public func supervisorWait(s: ref Supervisor, w: WorkerHandle): int {
    unsafe {
        return ar_rt_supervisor_wait(s.id, w.id)
    }
}

public func supervisorKill(s: ref Supervisor, w: WorkerHandle): int {
    unsafe {
        return ar_rt_supervisor_kill(s.id, w.id)
    }
}

// ===========================================================================
// SL_R — Concurrency: Bounded Ring-Buffer Channel<T> (DoD Zero-Alloc)
// ===========================================================================

extern "C" {
    func ar_vec_malloc(size: uint): ptr[u8]
    func ar_vec_buf_free(p: ptr[u8], size: uint): void
}

/// Bounded contiguous FIFO ring-buffer channel.
///
/// Pre-allocates buffer storage for `cap` elements; zero allocations during send/recv.
public struct Channel<T> {
    buf: ptr[Option<T>]
    cap: uint
    head: uint
    tail: uint
    len: uint
    is_closed: bool
}

/// Creates a new bounded channel with contiguous storage for `cap` items.
public func newChannel<T>(capacity: uint): Channel<T> {
    let cap = if capacity == 0 { 1 as uint } else { capacity }
    let byte_size = cap * (mem.sizeOf<Option<T>>() as uint)
    let raw = unsafe { ar_vec_malloc(byte_size) }
    let p = raw as ptr[Option<T>]
    let mut i = 0 as uint
    while i < cap {
        unsafe {
            let slot = mem.ptrOffset<Option<T>>(p, i as i32)
            mem.ptrWrite<Option<T>>(slot, Option.None)
        }
        i = i + 1
    }
    return Channel<T> {
        buf: p,
        cap: cap,
        head: 0,
        tail: 0,
        len: 0,
        is_closed: false,
    }
}

/// Returns the number of items currently buffered in the channel.
public func Channel.len<T>(self: ref Channel<T>): uint {
    return self.len
}

/// Returns the maximum capacity of the channel.
public func Channel.capacity<T>(self: ref Channel<T>): uint {
    return self.cap
}

/// Returns `true` if the channel has no buffered items.
public func Channel.isEmpty<T>(self: ref Channel<T>): bool {
    return self.len == 0
}

/// Returns `true` if the channel is at maximum capacity.
public func Channel.isFull<T>(self: ref Channel<T>): bool {
    return self.len == self.cap
}

/// Returns `true` if the channel has been closed.
public func Channel.isClosed<T>(self: ref Channel<T>): bool {
    return self.is_closed
}

/// Closes the channel. Subsequent sends will fail; remaining buffered items can still be received.
public func Channel.close<T>(self: mut ref Channel<T>): void {
    self.is_closed = true
}

/// Non-blocking send. Returns `true` on success, or `false` if full or closed.
public func Channel.trySend<T>(self: mut ref Channel<T>, val: T): bool {
    if self.is_closed || self.len == self.cap {
        return false
    }
    unsafe {
        let slot = mem.ptrOffset<Option<T>>(self.buf, self.tail as i32)
        mem.ptrWrite<Option<T>>(slot, Option.Some(val))
    }
    self.tail = (self.tail + 1) % self.cap
    self.len = self.len + 1
    return true
}

/// Non-blocking receive. Returns `Option.Some(item)` or `Option.None` if empty.
public func Channel.tryRecv<T>(self: mut ref Channel<T>): Option<T> {
    if self.len == 0 {
        return Option.None
    }
    let opt = unsafe {
        let slot = mem.ptrOffset<Option<T>>(self.buf, self.head as i32)
        let item = mem.ptrRead<Option<T>>(slot)
        mem.ptrWrite<Option<T>>(slot, Option.None)
        item
    }
    self.head = (self.head + 1) % self.cap
    self.len = self.len - 1
    return opt
}

/// Destroys the channel buffer and cleans up any remaining items.
public func Channel.destroy<T>(self: mut ref Channel<T>): void {
    unsafe {
        let nullp: ptr[Option<T>] = nil
        if self.buf != nullp {
            let byte_size = self.cap * (mem.sizeOf<Option<T>>() as uint)
            ar_vec_buf_free(self.buf as ptr[u8], byte_size)
            self.buf = nullp
            self.len = 0
        }
    }
}

// ===========================================================================
// SL_R — Concurrency: AsyncMutex<T>
// ===========================================================================

/// Mutual exclusion primitive for protecting shared data across cooperative tasks.
public struct AsyncMutex<T> {
    value: T
    is_locked: bool
    waker_id: int
}

/// Creates a new `AsyncMutex<T>` protecting `initial`.
public func newAsyncMutex<T>(initial: T): AsyncMutex<T> {
    return AsyncMutex<T> {
        value: initial,
        is_locked: false,
        waker_id: 0,
    }
}

/// Attempts to acquire the lock without suspending. Returns `true` if acquired, `false` if already held.
public func AsyncMutex.tryLock<T>(self: mut ref AsyncMutex<T>): bool {
    if self.is_locked {
        return false
    }
    self.is_locked = true
    return true
}

/// Returns `true` if the mutex is currently locked.
public func AsyncMutex.isLocked<T>(self: ref AsyncMutex<T>): bool {
    return self.is_locked
}

/// Releases the lock and wakes any waiting cooperative task.
public func AsyncMutex.unlock<T>(self: mut ref AsyncMutex<T>): void {
    self.is_locked = false
    if self.waker_id != 0 {
        let w = Waker { id: self.waker_id }
        unsafe {
            wakerWake(&w)
        }
        self.waker_id = 0
    }
}
/// Gets a copy of the protected value.
public func AsyncMutex.get<T>(self: ref AsyncMutex<T>): T {
    return self.value
}

/// Sets a new value for the protected data.
public func AsyncMutex.store<T>(self: mut ref AsyncMutex<T>, val: T): void {
    self.value = val
}
