module std.runtime

import std.core.mem as mem

/// SL_R — cooperative async **library** runtime.
///
/// Design: docs/arandu-async-runtime-design-v0.1.md
/// - `await` / `Coroutine[T]` = compiler (A3)
/// - this module = multi-task drive + OS reactor + process isolation (optional)
///
/// ## Arandu Minimal 0.1 — **IN** surface
/// `SyncExecutor`, `TaskHandle`, `new_sync_executor`, `spawn`/`join`/`block_on`
/// (and `*_int` / `*_i64` helpers). Default templates may use only this surface.
///
/// ## Experimental — not Minimal 0.1
/// Reactor, TCP, Waker, Supervisor ship in-tree and may appear in advanced tests,
/// but are **not** install-guaranteed and must not be required by `arandu new`
/// templates. See section banners below (`/// experimental — not Minimal 0.1`).
///
/// Host symbols (`ar_rt_*`) are linked by the Cranelift JIT.

// -- Host: SyncExecutor queue ------------------------------------------------
extern "C" {
    func ar_rt_block_on_i64(state: ptr[u8]): int
    func ar_rt_spawn_i64(state: ptr[u8]): int
    func ar_rt_join_i64(handle: int): int
    func ar_rt_cancel_i64(handle: int): void
}

// -- Host: reactor (epoll / io_uring) — experimental — not Minimal 0.1 -------
extern "C" {
    func ar_rt_reactor_create(): int
    func ar_rt_reactor_destroy(id: int): void
    func ar_rt_reactor_sleep_ms(id: int, ms: int): int
    func ar_rt_reactor_arm_timer_ms(id: int, ms: int): int
    func ar_rt_reactor_poll_ms(id: int, timeout_ms: int): int
    func ar_rt_reactor_backend(): int
    func ar_rt_reactor_register_socket(reactor_id: int, sock_id: int, events: int, waker_id: int): int
}

// -- Host: Waker — experimental — not Minimal 0.1 ----------------------------
extern "C" {
    func ar_rt_waker_create(): int
    func ar_rt_waker_wake(id: int): void
    func ar_rt_waker_wait(id: int, timeout_ms: int): int
    func ar_rt_waker_destroy(id: int): void
}

// -- Host: TCP — experimental — not Minimal 0.1 ------------------------------
extern "C" {
    func ar_rt_tcp_listen(port: int): int
    func ar_rt_tcp_accept(listener: int): int
    func ar_rt_tcp_connect(port: int): int
    func ar_rt_tcp_read(sock: int, buf: ptr[u8], len: int): int
    func ar_rt_tcp_write(sock: int, buf: ptr[u8], len: int): int
    func ar_rt_tcp_close(sock: int): void
    func ar_rt_tcp_set_nonblocking(sock: int, flag: int): int
    func ar_rt_tcp_wait(sock: int, events: int, timeout_ms: int): int
    func ar_rt_tcp_wait_wake(sock: int, events: int, timeout_ms: int, waker_id: int): int
    func ar_rt_tcp_read_async(sock: int, buf: ptr[u8], len: int): int
    func ar_rt_tcp_write_async(sock: int, buf: ptr[u8], len: int): int
}

// -- Host: supervisor — experimental — not Minimal 0.1 -----------------------
extern "C" {
    func ar_rt_supervisor_create(): int
    func ar_rt_supervisor_destroy(id: int): void
    func ar_rt_supervisor_spawn(sup: int, path_ptr: ptr[u8], path_len: int, max_restarts: int): int
    func ar_rt_supervisor_poll(sup: int, worker: int): int
    func ar_rt_supervisor_wait(sup: int, worker: int): int
    func ar_rt_supervisor_kill(sup: int, worker: int): int
}

// ===========================================================================
// SL_R.0 — SyncExecutor + generic Coroutine surface
// ===========================================================================

public struct SyncExecutor {
    flags: int
}

/// Opaque join handle (host queue id). Payload type is recovered at `join<T>`.
///
/// POD auto-copy (`id: int`): pass/reuse by value without move consumption.
public struct TaskHandle {
    id: int
}

public func newSyncExecutor(): SyncExecutor {
    return SyncExecutor { flags: 0 }
}

// Low-level ptr[u8] surface
public func blockOnI64(ex: ref SyncExecutor, state: ptr[u8]): int {
    unsafe {
        return ar_rt_block_on_i64(state)
    }
}

public func spawnI64(ex: ref SyncExecutor, state: ptr[u8]): int {
    unsafe {
        return ar_rt_spawn_i64(state)
    }
}

public func joinI64(ex: ref SyncExecutor, handle: int): int {
    unsafe {
        return ar_rt_join_i64(handle)
    }
}

public func cancelI64(ex: ref SyncExecutor, handle: int): void {
    unsafe {
        ar_rt_cancel_i64(handle)
    }
}

// -- Generic spawn / join / block_on (infers T from Coroutine[T]) ------------
// Host payload is i64 bits; `as T` is the ABI bridge for type params.

/// Drive `job` to completion; returns payload as `T` (i64-sized host MVP).
public func blockOn<T>(ex: ref SyncExecutor, job: Coroutine<T>): T {
    unsafe {
        let v = ar_rt_block_on_i64(job as ptr[u8])
        return v as T
    }
}

/// Spawn `job`; join with `join<T>`.
public func spawn<T>(ex: ref SyncExecutor, job: Coroutine<T>): TaskHandle {
    unsafe {
        let id = ar_rt_spawn_i64(job as ptr[u8])
        return TaskHandle { id: id }
    }
}

/// Join handle from `spawn`; returns payload as `T`.
public func join<T>(ex: ref SyncExecutor, handle: TaskHandle): T {
    unsafe {
        let v = ar_rt_join_i64(handle.id)
        return v as T
    }
}

public func cancel(ex: ref SyncExecutor, handle: TaskHandle): void {
    unsafe {
        ar_rt_cancel_i64(handle.id)
    }
}

// Concrete int surface (always linked; no mono required across modules).
// Prefer these for multi-file until mono specializes imported generics into AMIR.
public func blockOnInt(ex: ref SyncExecutor, job: Coroutine<int>): int {
    unsafe {
        return ar_rt_block_on_i64(job as ptr[u8])
    }
}

public func spawnInt(ex: ref SyncExecutor, job: Coroutine<int>): TaskHandle {
    unsafe {
        let id = ar_rt_spawn_i64(job as ptr[u8])
        return TaskHandle { id: id }
    }
}

public func joinInt(ex: ref SyncExecutor, handle: TaskHandle): int {
    unsafe {
        return ar_rt_join_i64(handle.id)
    }
}

public func cancelInt(ex: ref SyncExecutor, handle: TaskHandle): void {
    unsafe {
        ar_rt_cancel_i64(handle.id)
    }
}

// ===========================================================================
// experimental — not Minimal 0.1 — SL_R.2/3 EpollReactor
// ===========================================================================

/// experimental — not Minimal 0.1
public struct EpollReactor {
    id: int
}

/// 0 = portable, 1 = epoll, 2 = io_uring (runtime detect).
public func reactorBackend(): int {
    unsafe {
        return ar_rt_reactor_backend()
    }
}

public func newEpollReactor(): EpollReactor {
    unsafe {
        return EpollReactor { id: ar_rt_reactor_create() }
    }
}

public func destroyReactor(r: ref EpollReactor): void {
    unsafe {
        ar_rt_reactor_destroy(r.id)
    }
}

public func reactorSleepMs(r: ref EpollReactor, ms: int): int {
    unsafe {
        return ar_rt_reactor_sleep_ms(r.id, ms)
    }
}

public func reactorArmTimerMs(r: ref EpollReactor, ms: int): int {
    unsafe {
        return ar_rt_reactor_arm_timer_ms(r.id, ms)
    }
}

public func reactorPollMs(r: ref EpollReactor, timeoutMs: int): int {
    unsafe {
        return ar_rt_reactor_poll_ms(r.id, timeoutMs)
    }
}

public func reactorRegisterSocket(r: ref EpollReactor, s: ref TcpStream, events: int, w: ref Waker): int {
    unsafe {
        return ar_rt_reactor_register_socket(r.id, s.id, events, w.id)
    }
}

// ===========================================================================
// experimental — not Minimal 0.1 — Waker / Context
// ===========================================================================

/// experimental — not Minimal 0.1
public struct Waker {
    id: int
}

/// experimental — not Minimal 0.1
public struct Context {
    waker: Waker
}

public func newWaker(): Waker {
    unsafe {
        return Waker { id: ar_rt_waker_create() }
    }
}

public func wakerWake(w: ref Waker): void {
    unsafe {
        ar_rt_waker_wake(w.id)
    }
}

/// Wait until woken or timeout. 1 = woken, 0 = timeout, -1 = error.
public func wakerWait(w: ref Waker, timeoutMs: int): int {
    unsafe {
        return ar_rt_waker_wait(w.id, timeoutMs)
    }
}

public func destroyWaker(w: ref Waker): void {
    unsafe {
        ar_rt_waker_destroy(w.id)
    }
}

public func newContext(w: Waker): Context {
    return Context { waker: w }
}

// ===========================================================================
// experimental — not Minimal 0.1 — TCP sockets
// ===========================================================================

/// experimental — not Minimal 0.1
public struct TcpListener {
    id: int
}

/// experimental — not Minimal 0.1
public struct TcpStream {
    id: int
}

/// Wait flags for `tcpWait` / `tcpWaitWake` (bit0=read, bit1=write).
public func tcpWaitReadFlag(): int {
    return 1
}

public func tcpWaitWriteFlag(): int {
    return 2
}

public func tcpListen(port: int): TcpListener {
    unsafe {
        return TcpListener { id: ar_rt_tcp_listen(port) }
    }
}

public func tcpAccept(l: ref TcpListener): TcpStream {
    unsafe {
        return TcpStream { id: ar_rt_tcp_accept(l.id) }
    }
}

public func tcpConnect(port: int): TcpStream {
    unsafe {
        return TcpStream { id: ar_rt_tcp_connect(port) }
    }
}

public func tcpRead(s: ref TcpStream, buf: ptr[u8], len: int): int {
    unsafe {
        return ar_rt_tcp_read(s.id, buf, len)
    }
}

public func tcpWrite(s: ref TcpStream, buf: ptr[u8], len: int): int {
    unsafe {
        return ar_rt_tcp_write(s.id, buf, len)
    }
}

/// Prefer io_uring when `reactorBackend() == 2`, else blocking/host read.
public func tcpReadAsync(s: ref TcpStream, buf: ptr[u8], len: int): int {
    unsafe {
        return ar_rt_tcp_read_async(s.id, buf, len)
    }
}

public func tcpWriteAsync(s: ref TcpStream, buf: ptr[u8], len: int): int {
    unsafe {
        return ar_rt_tcp_write_async(s.id, buf, len)
    }
}

/// `flag != 0` → nonblocking (WouldBlock returns -2 from read/write).
public func tcpSetNonblocking(s: ref TcpStream, flag: int): int {
    unsafe {
        return ar_rt_tcp_set_nonblocking(s.id, flag)
    }
}

/// Wait for readiness. Returns ready event bits, 0 timeout, -1 error.
public func tcpWait(s: ref TcpStream, events: int, timeoutMs: int): int {
    unsafe {
        return ar_rt_tcp_wait(s.id, events, timeoutMs)
    }
}

/// Wait then wake `w` if ready (async + Waker bridge).
public func tcpWaitWake(s: ref TcpStream, events: int, timeoutMs: int, w: ref Waker): int {
    unsafe {
        return ar_rt_tcp_wait_wake(s.id, events, timeoutMs, w.id)
    }
}

public func tcpCloseListener(l: ref TcpListener): void {
    unsafe {
        ar_rt_tcp_close(l.id)
    }
}

public func tcpCloseStream(s: ref TcpStream): void {
    unsafe {
        ar_rt_tcp_close(s.id)
    }
}

