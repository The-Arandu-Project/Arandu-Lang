module std.alloc.allocator_api

/// Minimal 0.1 — thin allocator surface.
///
/// Free-function API:
/// - Global heap via pure-buffer hosts (`ar_vec_*`)
/// - `BumpArena` — contiguous bump; power-of-two align; `bumpReset` / `bumpDestroy`
///
/// Fallible paths return `Result<_, AllocError>`.

import std.core.mem as mem

extern "C" {
    func ar_vec_malloc(size: u64): ptr[u8]
    func ar_vec_buf_free(p: ptr[u8], size: u64): void
    func ar_vec_realloc(p: ptr[u8], oldSize: u64, newSize: u64): ptr[u8]
}

/// Failure modes for fallible alloc (thin enum).
public enum AllocError {
    OutOfMemory,
    InvalidLayout,
}

/// Process-global heap tag (POD auto-copy, zero fields).
public struct GlobalAllocator {}

/// Create the global allocator tag.
public func global(): GlobalAllocator {
    return GlobalAllocator {}
}

/// Allocate `size` bytes.
public func globalAlloc(size: u64): Result<ptr[u8], AllocError> {
    if size == 0 {
        return Result.Err(AllocError.InvalidLayout)
    }
    unsafe {
        let nullp: ptr[u8] = nil
        let p = ar_vec_malloc(size)
        if p == nullp {
            return Result.Err(AllocError.OutOfMemory)
        }
        return Result.Ok(p)
    }
}

/// Free a buffer from [`globalAlloc`] / [`globalRealloc`].
public func globalDealloc(p: ptr[u8], size: u64): void {
    unsafe {
        ar_vec_buf_free(p, size)
    }
}

/// Grow/shrink buffer.
public func globalRealloc(p: ptr[u8], oldSize: u64, newSize: u64): Result<ptr[u8], AllocError> {
    if newSize == 0 {
        return Result.Err(AllocError.InvalidLayout)
    }
    unsafe {
        let nullp: ptr[u8] = nil
        let q = ar_vec_realloc(p, oldSize, newSize)
        if q == nullp {
            return Result.Err(AllocError.OutOfMemory)
        }
        return Result.Ok(q)
    }
}

// ── Bump arena ────────────────────────────────────────────────────────────

/// Contiguous bump region (allocate-only until `bumpReset` / `bumpDestroy`).
public struct BumpArena {
    buffer: ptr[u8]
    capacity: u64
    offset: u64
}

/// New bump with capacity bytes (malloc once).
public func bumpNew(capacity: u64): Result<BumpArena, AllocError> {
    if capacity == 0 {
        return Result.Err(AllocError.InvalidLayout)
    }
    unsafe {
        let nullp: ptr[u8] = nil
        let p = ar_vec_malloc(capacity)
        if p == nullp {
            return Result.Err(AllocError.OutOfMemory)
        }
        return Result.Ok(BumpArena {
            buffer: p,
            capacity: capacity,
            offset: 0 as u64,
        })
    }
}

/// Bump-allocate `size` bytes with `align` (min 1).
public func bumpAlloc(a: mut ref BumpArena, size: u64, align: u64): Result<ptr[u8], AllocError> {
    let mut al: u64 = align
    if al == 0 {
        al = 1 as u64
    }
    let off = a.offset
    let aligned = ((off + al - 1) / al) * al
    if aligned + size > a.capacity {
        return Result.Err(AllocError.OutOfMemory)
    }
    a.offset = aligned + size
    unsafe {
        let p = mem.ptrOffset<u8>(a.buffer, aligned as i32)
        return Result.Ok(p)
    }
}

/// Reset offset to 0 (memory retained).
public func bumpReset(a: mut ref BumpArena): void {
    a.offset = 0 as u64
}

/// Bytes still free in the bump.
public func bumpRemaining(a: ref BumpArena): u64 {
    return a.capacity - a.offset
}

/// Free the underlying buffer.
public func bumpDestroy(a: mut ref BumpArena): void {
    if a.capacity > 0 {
        unsafe {
            ar_vec_buf_free(a.buffer, a.capacity)
        }
        a.buffer = nil
        a.capacity = 0 as u64
        a.offset = 0 as u64
    }
}
