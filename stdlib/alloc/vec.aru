module std.alloc.vec

/// Minimal 0.1 — growable array (`Vec<T>`).
///
/// # Design
/// Contiguous pure-buffer storage: host raw allocators
/// (`ar_vec_malloc` / `ar_vec_realloc` / `ar_vec_buf_free`) + typed access via
/// mem intrinsics (`sizeOf` / `ptrOffset` / `ptrRead` / `ptrWrite`).
///
/// Growth: geometric factor 2, minimum capacity 8 (amortised O(1) append).

import std.core.mem as mem
import std.core.intrinsics as intrinsics

extern "C" {
    func ar_vec_malloc(size: u64): ptr[u8]
    func ar_vec_buf_free(p: ptr[u8], size: u64): void
    func ar_vec_realloc(p: ptr[u8], oldSize: u64, newSize: u64): ptr[u8]
}

/// Growable contiguous buffer of `T`.
public struct Vec<T> {
    data: ptr[T]
    len: u64
    capacity: u64
}

/// Empty vector (no allocation until first `push` or `reserve` / `withCapacity`).
public func new<T>(): Vec<T> {
    return Vec<T> {
        data: nil,
        len: 0 as u64,
        capacity: 0 as u64,
    }
}

/// Empty vector with room for at least `cap` elements.
public func withCapacity<T>(cap: u64): Vec<T> {
    let mut v = new<T>()
    ensureCapacity<T>(v, cap)
    return v
}

/// Ensure absolute capacity ≥ `minCap`.
func ensureCapacity<T>(v: mut ref Vec<T>, minCap: u64): void {
    if v.capacity >= minCap {
        return
    }
    let maxCap: u64 = 2147483647 as u64
    if minCap > maxCap {
        unsafe {
            intrinsics.abort()
        }
    }
    let mut newCap: u64 = v.capacity
    if newCap == 0 {
        newCap = 8 as u64
    }
    while newCap < minCap {
        if newCap > maxCap / 2 {
            newCap = maxCap
        } else {
            newCap = newCap * 2
        }
    }
    let elem = mem.sizeOf<T>()
    if elem > 0 && newCap > ((18446744073709551615 as u64) / elem) {
        unsafe {
            intrinsics.abort()
        }
    }
    let oldBytes = v.capacity * elem
    let newBytes = newCap * elem
    unsafe {
        let nullp: ptr[u8] = nil
        let p = ar_vec_realloc(v.data as ptr[u8], oldBytes, newBytes)
        if p == nullp {
            intrinsics.abort()
        }
        v.data = p as ptr[T]
        v.capacity = newCap
    }
}

/// Reserve room for at least `additional` more elements beyond `len`.
public func reserve<T>(v: mut ref Vec<T>, additional: u64): void {
    let maxCap: u64 = 2147483647 as u64
    if additional > maxCap - v.len {
        unsafe {
            intrinsics.abort()
        }
    }
    let need = v.len + additional
    ensureCapacity<T>(v, need)
}

/// Append `value` (amortized O(1)).
public func push<T>(v: mut ref Vec<T>, value: T): void {
    let maxCap: u64 = 2147483647 as u64
    if v.len >= maxCap {
        unsafe {
            intrinsics.abort()
        }
    }
    let need = v.len + 1
    if v.capacity < need {
        ensureCapacity<T>(v, need)
    }
    unsafe {
        let dest = mem.ptrOffset<T>(v.data, v.len as i32)
        mem.ptrWrite<T>(dest, value)
    }
    v.len = v.len + 1
}

/// Remove last element, or `None` if empty.
public func pop<T>(v: mut ref Vec<T>): Option<T> {
    if v.len == 0 {
        return Option.None
    }
    v.len = v.len - 1
    unsafe {
        let elemPtr = mem.ptrOffset<T>(v.data, v.len as i32)
        return Option.Some(mem.ptrRead<T>(elemPtr))
    }
}

/// Element at `index`, or `None` if out of range.
public func get<T>(v: ref Vec<T>, index: u64): Option<T> {
    let maxCap: u64 = 2147483647 as u64
    if index >= v.len || index > maxCap {
        return Option.None
    }
    unsafe {
        let elemPtr = mem.ptrOffset<T>(v.data, index as i32)
        return Option.Some(mem.ptrRead<T>(elemPtr))
    }
}

/// Overwrite index; `false` if out of range.
public func put<T>(v: mut ref Vec<T>, index: u64, value: T): bool {
    let maxCap: u64 = 2147483647 as u64
    if index >= v.len || index > maxCap {
        return false
    }
    unsafe {
        let elemPtr = mem.ptrOffset<T>(v.data, index as i32)
        mem.ptrWrite<T>(elemPtr, value)
    }
    return true
}

/// Number of elements.
public func len<T>(v: ref Vec<T>): u64 {
    return v.len
}

/// Allocated capacity (element slots).
public func capacity<T>(v: ref Vec<T>): u64 {
    return v.capacity
}

/// `true` if `len == 0`.
public func isEmpty<T>(v: ref Vec<T>): bool {
    return v.len == 0
}

/// Shared zero-copy view of the initialized prefix.
public func asSlice<T>(v: ref Vec<T>): []T {
    unsafe {
        return intrinsics.sliceFromRaw<Vec<T>, T>(v, v.data, v.len)
    }
}

/// Drop length to zero (capacity retained).
public func clear<T>(v: mut ref Vec<T>): void {
    v.len = 0 as u64
}

/// Deallocate the buffer and reset to empty.
public func destroy<T>(v: mut ref Vec<T>): void {
    if v.capacity > 0 {
        let size = v.capacity * mem.sizeOf<T>()
        unsafe {
            ar_vec_buf_free(v.data as ptr[u8], size)
        }
        v.data = nil
        v.capacity = 0 as u64
        v.len = 0 as u64
    }
}

// ── Method-style surface ───────────────────────────────────────────────────

/// Method form of [`push`].
public func Vec.push<T>(self: mut ref Vec<T>, value: T): void {
    push(self, value)
}

/// Method form of [`pop`].
public func Vec.pop<T>(self: mut ref Vec<T>): Option<T> {
    return pop(self)
}

/// Method form of [`get`].
public func Vec.get<T>(self: ref Vec<T>, index: u64): Option<T> {
    return get(self, index)
}

/// Method form of [`put`].
public func Vec.put<T>(self: mut ref Vec<T>, index: u64, value: T): bool {
    return put(self, index, value)
}

/// Method form of [`len`].
public func Vec.len<T>(self: ref Vec<T>): u64 {
    return len(self)
}

/// Method form of [`capacity`].
public func Vec.capacity<T>(self: ref Vec<T>): u64 {
    return capacity(self)
}

/// Method form of [`isEmpty`].
public func Vec.isEmpty<T>(self: ref Vec<T>): bool {
    return isEmpty(self)
}

public func Vec.asSlice<T>(self: ref Vec<T>): []T {
    return asSlice<T>(self)
}

/// Method form of [`reserve`].
public func Vec.reserve<T>(self: mut ref Vec<T>, additional: u64): void {
    reserve(self, additional)
}

/// Method form of [`clear`].
public func Vec.clear<T>(self: mut ref Vec<T>): void {
    clear(self)
}

/// Method form of [`destroy`].
@Destructor
public func Vec.destroy<T>(self: own Vec<T>): void {
    destroy(self)
}
