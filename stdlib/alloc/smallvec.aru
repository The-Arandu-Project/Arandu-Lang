module std.alloc.smallvec

import std.core.mem as mem

extern "C" {
    func ar_vec_malloc(size: uint): ptr[u8]
    func ar_vec_buf_free(p: ptr[u8], size: uint): void
    func ar_vec_realloc(p: ptr[u8], oldSize: uint, newSize: uint): ptr[u8]
}

/// Small vector optimized for holding up to 4 elements inline on the stack without heap allocation.
///
/// Follows LLVM SmallVector's Data-Oriented Design (DoD):
/// - Uses inline buffer for <= 4 elements.
/// - Spills to heap memory only when exceeding 4 elements.
public struct SmallVec4<T> {
    data: ptr[Option<T>]
    len: uint
    capacity: uint
    is_heap: bool
    inline_buf: [4]Option<T>
}

/// Creates a new empty `SmallVec4<T>` with inline storage ready (capacity = 4).
public func new<T>(): SmallVec4<T> {
    return SmallVec4<T> {
        data: nil,
        len: 0,
        capacity: 4,
        is_heap: false,
        inline_buf: [Option.None, Option.None, Option.None, Option.None],
    }
}

/// Returns the number of elements in the small vector.
public func SmallVec4.len<T>(self: ref SmallVec4<T>): uint {
    return self.len
}

/// Returns `true` if the small vector contains no elements.
public func SmallVec4.isEmpty<T>(self: ref SmallVec4<T>): bool {
    return self.len == 0
}

/// Returns the current capacity (starts at 4 inline, grows geometrically on heap).
public func SmallVec4.capacity<T>(self: ref SmallVec4<T>): uint {
    return self.capacity
}

/// Returns `true` if storage has spilled into the heap.
public func SmallVec4.isHeap<T>(self: ref SmallVec4<T>): bool {
    return self.is_heap
}

/// Appends an element to the small vector.
///
/// If `len < 4`, writes into inline storage without heap allocation.
/// If `len == capacity`, spills to or reallocates on the heap.
public func SmallVec4.push<T>(self: mut ref SmallVec4<T>, val: T): void {
    if !self.is_heap {
        if self.len == 0 {
            self.inline_buf[0] = Option.Some(val)
            self.len = 1
            return
        }
        if self.len == 1 {
            self.inline_buf[1] = Option.Some(val)
            self.len = 2
            return
        }
        if self.len == 2 {
            self.inline_buf[2] = Option.Some(val)
            self.len = 3
            return
        }
        if self.len == 3 {
            self.inline_buf[3] = Option.Some(val)
            self.len = 4
            return
        }
        let new_cap: uint = 8
        let elem_size = mem.sizeOf<Option<T>>()
        unsafe {
            let raw = ar_vec_malloc(new_cap * elem_size)
            let heap_ptr = raw as ptr[Option<T>]

            let p0 = mem.ptrOffset<Option<T>>(heap_ptr, 0)
            mem.ptrWrite<Option<T>>(p0, self.inline_buf[0])
            let p1 = mem.ptrOffset<Option<T>>(heap_ptr, 1)
            mem.ptrWrite<Option<T>>(p1, self.inline_buf[1])
            let p2 = mem.ptrOffset<Option<T>>(heap_ptr, 2)
            mem.ptrWrite<Option<T>>(p2, self.inline_buf[2])
            let p3 = mem.ptrOffset<Option<T>>(heap_ptr, 3)
            mem.ptrWrite<Option<T>>(p3, self.inline_buf[3])
            let p4 = mem.ptrOffset<Option<T>>(heap_ptr, 4)
            mem.ptrWrite<Option<T>>(p4, Option.Some(val))

            self.data = heap_ptr
        }
        self.capacity = new_cap
        self.len = 5
        self.is_heap = true
        return
    }

    if self.len >= self.capacity {
        let new_cap = self.capacity * 2
        let elem_size = mem.sizeOf<Option<T>>()
        unsafe {
            let raw = ar_vec_realloc(self.data as ptr[u8], self.capacity * elem_size, new_cap * elem_size)
            self.data = raw as ptr[Option<T>]
        }
        self.capacity = new_cap
    }

    unsafe {
        let p = mem.ptrOffset<Option<T>>(self.data, self.len as i32)
        mem.ptrWrite<Option<T>>(p, Option.Some(val))
    }
    self.len = self.len + 1
}

/// Retrieves an element at `index`, or `Option.None` if out of bounds.
public func SmallVec4.get<T>(self: ref SmallVec4<T>, index: uint): Option<T> {
    if index >= self.len {
        return Option.None
    }
    if !self.is_heap {
        if index == 0 {
            return self.inline_buf[0]
        }
        if index == 1 {
            return self.inline_buf[1]
        }
        if index == 2 {
            return self.inline_buf[2]
        }
        return self.inline_buf[3]
    }
    unsafe {
        let p = mem.ptrOffset<Option<T>>(self.data, index as i32)
        return mem.ptrRead<Option<T>>(p)
    }
}

/// Removes and returns the last element, or `Option.None` if empty.
public func SmallVec4.pop<T>(self: mut ref SmallVec4<T>): Option<T> {
    if self.len == 0 {
        return Option.None
    }
    let last_idx = self.len - 1
    let val = self.get(last_idx)
    self.len = last_idx
    return val
}

/// Clears all elements from the small vector.
public func SmallVec4.clear<T>(self: mut ref SmallVec4<T>): void {
    self.len = 0
}

/// Releases any allocated heap memory.
public func SmallVec4.destroy<T>(self: mut ref SmallVec4<T>): void {
    if self.is_heap {
        let elem_size = mem.sizeOf<Option<T>>()
        unsafe {
            ar_vec_buf_free(self.data as ptr[u8], self.capacity * elem_size)
        }
        self.data = nil
        self.is_heap = false
        self.capacity = 4
        self.len = 0
    }
}
