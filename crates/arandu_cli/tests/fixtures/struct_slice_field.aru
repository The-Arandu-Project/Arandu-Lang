module tests.borrowed_views.struct_slice

import std.alloc.vec as vec
import std.core.slice as slice

struct Holder {
    items: []int
}

func sum(items: []int): int {
    let ctx = Holder { items: items }
    if slice.len<int>(ctx.items) != 3 { return 40 }
    if ctx.items[0] != 1 { return 10 }
    if ctx.items[1] != 2 { return 20 }
    if ctx.items[2] != 4 { return 30 }
    return 7
}

func main(): int {
    let mut values = vec.new<int>()
    vec.push<int>(values, 1)
    vec.push<int>(values, 2)
    vec.push<int>(values, 4)
    let view = vec.asSlice<int>(values)
    return sum(view)
}
